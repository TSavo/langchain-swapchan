{
  "name": "langchain-swapchan",
  "version": "0.1.0",
  "description": "LangChain.js tools for SwapChan: best-price swap and bridge quotes across every DEX aggregator and bridge, server-verified unsigned transactions, and free chain readers. No API key.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "langchain",
    "langchainjs",
    "tools",
    "toolkit",
    "swap",
    "dex",
    "aggregator",
    "bridge",
    "cross-chain",
    "solana",
    "evm",
    "defi",
    "agent"
  ],
  "author": "T Robert Savo",
  "license": "MIT",
  "homepage": "https://swapchan.com/agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TSavo/langchain-swapchan.git",
    "directory": "js"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.3",
    "zod": ">=3.25"
  },
  "devDependencies": {
    "@langchain/core": "^1.3.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  }
}
